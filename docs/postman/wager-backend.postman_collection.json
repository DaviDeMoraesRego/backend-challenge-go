{
  "info": {
    "name": "Wager Backend · Local (fluxo completo)",
    "description": "Exercita tudo ponta a ponta: autenticação real (Keycloak), health, carteira (internal), operações (provider-a), idempotência (replay/conflito), reversões, isolamento entre provedores e 404. Rode as pastas NA ORDEM (00 -> 04).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "keycloakUrl", "value": "http://localhost:8080" },
    { "key": "realm", "value": "wager" }
  ],
  "item": [
    {
      "name": "00 · Auth (Keycloak)",
      "item": [
        {
          "name": "Token · internal-service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('internalToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "internal-service" },
                { "key": "client_secret", "value": "dev-internal-service-secret" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "Token · provider-a",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('providerAToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "provider-a" },
                { "key": "client_secret", "value": "dev-provider-a-secret" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "Token · provider-b",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('providerBToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "provider-b" },
                { "key": "client_secret", "value": "dev-provider-b-secret" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "01 · Health (público)",
      "item": [
        {
          "name": "Liveness",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health/live" }
        },
        {
          "name": "Readiness (Postgres + SQS)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "02 · Carteira (internal)",
      "item": [
        {
          "name": "Abrir carteira (201) — captura walletId/playerId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.environment.set('walletId', b.id);",
                  "pm.environment.set('playerId', b.playerId);",
                  "pm.test('saldo inicial 1000.00', () => pm.expect(b.balance.amount).to.eql('1000.00'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{internalToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{$guid}}\",\n  \"initialBalance\": { \"amount\": \"1000.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wallets"
          }
        },
        {
          "name": "Consultar carteira (200)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internalToken}}" }],
            "url": "{{baseUrl}}/wallets/{{walletId}}"
          }
        },
        {
          "name": "Extrato — ledger?limit=50 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "if (b.nextCursor) pm.environment.set('nextCursor', b.nextCursor);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internalToken}}" }],
            "url": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=50"
          }
        },
        {
          "name": "Reconciliação (200 · consistent=true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('consistente', () => pm.expect(pm.response.json().consistent).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{internalToken}}" }],
            "url": "{{baseUrl}}/wallets/{{walletId}}/reconciliation"
          }
        }
      ]
    },
    {
      "name": "03 · Operações (provider-a)",
      "item": [
        {
          "name": "BET 25.00 (200 PROCESSED) — captura txId",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const guid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('betExternalId', guid);",
                  "pm.environment.set('betIdemKey', 'provider-a:' + guid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('PROCESSED', () => pm.expect(b.status).to.eql('PROCESSED'));",
                  "pm.test('saldo 975.00', () => pm.expect(b.balance.amount).to.eql('975.00'));",
                  "pm.environment.set('txId', b.transactionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "{{betIdemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "BET replay (mesma chave/conteúdo → idempotentReplay=true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('replay', () => pm.expect(b.idempotentReplay).to.eql(true));",
                  "pm.test('saldo original 975.00', () => pm.expect(b.balance.amount).to.eql('975.00'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "{{betIdemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "BET conflito (mesma chave, corpo diferente → 409)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409', () => pm.response.to.have.status(409));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "{{betIdemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"30.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "WIN 50.00 (200 PROCESSED)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const guid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('winExternalId', guid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('PROCESSED', () => pm.expect(b.status).to.eql('PROCESSED'));",
                  "pm.environment.set('balanceAfterWin', b.balance.amount);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "provider-a:{{winExternalId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{winExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"WIN\",\n  \"money\": { \"amount\": \"50.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "LOSS 0.00 (200 PROCESSED · saldo inalterado)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.environment.set('lossExternalId', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('PROCESSED', () => pm.expect(b.status).to.eql('PROCESSED'));",
                  "pm.test('LOSS nao altera o saldo', () => pm.expect(b.balance.amount).to.eql(pm.environment.get('balanceAfterWin')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "provider-a:{{lossExternalId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{lossExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"LOSS\",\n  \"money\": { \"amount\": \"0.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "REFUND da BET 25.00 (200 PROCESSED)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.environment.set('refundExternalId', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('PROCESSED', () => pm.expect(pm.response.json().status).to.eql('PROCESSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "provider-a:{{refundExternalId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{refundExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"REFUND\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" },\n  \"referenceExternalTransactionId\": \"{{betExternalId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "ROLLBACK duplicado da BET (200 REJECTED · DUPLICATE_REVERSAL)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "provider-a:{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{$guid}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"ROLLBACK\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" },\n  \"referenceExternalTransactionId\": \"{{betExternalId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        },
        {
          "name": "Consulta por id (200)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAToken}}" }],
            "url": "{{baseUrl}}/wagering/transactions/{{txId}}"
          }
        },
        {
          "name": "Consulta por par externo (200)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAToken}}" }],
            "url": "{{baseUrl}}/providers/provider-a/wagering/transactions/{{betExternalId}}"
          }
        },
        {
          "name": "Carteira inexistente (404)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Idempotency-Key", "value": "provider-a:{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{$guid}}\",\n  \"playerId\": \"{{$guid}}\",\n  \"walletId\": \"0192f291-ffff-7fff-8fff-ffffffffffff\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"10.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wagering/transactions"
          }
        }
      ]
    },
    {
      "name": "04 · Autorização / isolamento",
      "item": [
        {
          "name": "provider-b lê transação do provider-a (403)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerBToken}}" }],
            "url": "{{baseUrl}}/providers/provider-a/wagering/transactions/{{betExternalId}}"
          }
        },
        {
          "name": "provider-a tenta abrir carteira (403)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{$guid}}\",\n  \"initialBalance\": { \"amount\": \"10.00\", \"currency\": \"BRL\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wallets"
          }
        },
        {
          "name": "Sem token (401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}"
          }
        }
      ]
    }
  ]
}
