# Variáveis do ambiente local. Copie para `.env` (que está no .gitignore) antes do
# `docker compose up`. Nenhum valor é segredo de produção — são credenciais de teste.
# A app lê tudo no startup e valida (config inválida não sobe).
#
# AWS_ENDPOINT_URL aponta para o LocalStack; em produção, remover a variável faz o
# SDK usar a AWS real. As credenciais do LocalStack podem ser qualquer valor NÃO vazio,
# mas AWS_DEFAULT_REGION precisa casar com a região do broker (assinatura SigV4).

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=wager
POSTGRES_PASSWORD=wager
POSTGRES_DB=wager
# Porta publicada no host (o serviço interno sempre usa postgres:5432).
POSTGRES_PORT=5432
# URL de conexão usada pela aplicação Go e por ferramentas locais.
DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable

# -----------------------------------------------------------------------------
# AWS / SQS (LocalStack)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Endpoint do LocalStack. Vazio => SDK usa o endpoint real da AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciais de teste (obrigatórias para o SDK assinar requisições).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# URL base do edge do LocalStack, usada para montar as queue URLs nos logs/comandos.
LOCALSTACK_URL=http://localhost:4566
# Topologia de filas (criada automaticamente pelo init do LocalStack).
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# -----------------------------------------------------------------------------
# Keycloak (IdP OAuth2/OIDC)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=wager
# Mapeia o emissor OpenID Connect (claim `iss` que a API valida).
KEYCLOAK_ISSUER=http://localhost:8080/realms/wager
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/wager/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/wager/protocol/openid-connect/token
# Identidades de teste (client_credentials). Ver deploy/keycloak/realm-export.json.
OIDC_CLIENT_ID_INTERNAL=internal-service
OIDC_CLIENT_SECRET_INTERNAL=dev-internal-service-secret
OIDC_CLIENT_ID_PROVIDER_A=provider-a
OIDC_CLIENT_SECRET_PROVIDER_A=dev-provider-a-secret
OIDC_CLIENT_ID_PROVIDER_B=provider-b
OIDC_CLIENT_SECRET_PROVIDER_B=dev-provider-b-secret

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Endereço HTTP da API (dentro do container usa :8080).
HTTP_ADDR=:8080
LOG_LEVEL=info
# Timeouts do servidor HTTP (proteção contra conexões lentas/ociosas).
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Nome do consumidor SQS, usado na chave (consumer_name, message_id) da inbox.
SQS_CONSUMER_NAME=wager-transactions-worker
# Quantas mensagens o consumidor busca por poll.
SQS_MAX_MESSAGES=10
# Long polling (segundos). Evita busy-loop consumindo CPU e gerando custo/ruído.
SQS_WAIT_TIME_SECONDS=20
# Worker de referências pendentes: intervalo de varredura e teto de tentativas.
PENDING_REFERENCE_SCAN_INTERVAL=5s
PENDING_REFERENCE_MAX_ATTEMPTS=8
# Backoff inicial do outbox/resolução (exponencial a partir daqui).
OUTBOX_BASE_BACKOFF=2s
OUTBOX_POLL_INTERVAL=1s

# -----------------------------------------------------------------------------
# Observabilidade (Passo 5; OTel é diferencial do Passo 8)
# -----------------------------------------------------------------------------
METRICS_ADDR=:9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=wager-backend
OTEL_TRACES_ENABLED=false
